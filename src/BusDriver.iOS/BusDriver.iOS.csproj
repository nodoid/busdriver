<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BusDriver</AssemblyName>
    <RootNamespace>BusDriver.iOS</RootNamespace>
    <ApplicationId>uk.co.scarthorpe.busdriver</ApplicationId>
    <ApplicationTitle>Bus Driver</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <Company>Scarthorpe Games</Company>
    <Product>Bus Driver</Product>
    <Copyright>© 2026 Scarthorpe Games</Copyright>
    <!-- MonoGame resolves art and audio by name at runtime, so keep trimming off. -->
    <MtouchLink>None</MtouchLink>
    <!-- Debug device builds use the interpreter; the AOT image is fragile on
         this SDK while iterating.  Release builds use the normal AOT path. -->
    <MtouchInterpreter Condition="'$(Configuration)' == 'Debug'">all</MtouchInterpreter>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusDriver.Game\BusDriver.Game.csproj">
      <SetTargetFramework>TargetFramework=net10.0-ios</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <BundleResource Include="..\..\Content\**\*.*"
                    Link="Content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ImageAsset Include="Assets.xcassets\**\*.*" />
  </ItemGroup>

</Project>
