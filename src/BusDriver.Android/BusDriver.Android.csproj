<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>32</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BusDriver</AssemblyName>
    <RootNamespace>BusDriver.Android</RootNamespace>
    <ApplicationId>uk.co.allthejohnsons.busdriver</ApplicationId>
    <ApplicationTitle>Bus Driver</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <Company>Scarthorpe Games</Company>
    <Product>Bus Driver</Product>
    <Copyright>© 2026 Scarthorpe Games</Copyright>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusDriver.Game\BusDriver.Game.csproj">
      <SetTargetFramework>TargetFramework=net10.0-android</SetTargetFramework>
      <GlobalPropertiesToRemove>RuntimeIdentifier</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="..\..\Content\**\*.*"
                  Link="Content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
